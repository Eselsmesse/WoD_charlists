# Скопируйте в .env (файл .env не коммитится) и заполните значения.
# Загружается настройками автоматически (backend/config/settings/base.py).

# --- Django ---
# Секретный ключ. Сгенерировать:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# В dev можно не задавать (есть небезопасный дефолт), в prod — ОБЯЗАТЕЛЕН.
DJANGO_SECRET_KEY=

# Режим отладки: true/false (dev-дефолт: true, prod-дефолт: false)
DJANGO_DEBUG=true

# Хосты через запятую (dev-дефолт: localhost,127.0.0.1; в prod обязателен)
DJANGO_ALLOWED_HOSTS=

# Путь к файлу SQLite (по умолчанию backend/db.sqlite3)
# DJANGO_SQLITE_PATH=

# Перенаправлять на HTTPS в prod: true/false (по умолчанию true)
# DJANGO_SECURE_SSL_REDIRECT=true

# --- JWT ---
# Время жизни access-токена в минутах (по умолчанию 15)
# JWT_ACCESS_LIFETIME_MINUTES=15
# Время жизни refresh-токена в днях (по умолчанию 7)
# JWT_REFRESH_LIFETIME_DAYS=7

# --- CORS ---
# Origin'ы SPA через запятую (dev-дефолт: http://localhost:5173,http://127.0.0.1:5173)
# CORS_ALLOWED_ORIGINS=
